# Makefile for vsn / MacOSX

G = -g

CXX=`wx-config --cxx`

VFRDIR=../vfr/dist
TP_DIR = ../RikenLib/TextParser/eoe
TMPLDIR = $(VFRDIR)/tmpl
NVR_DIR = ../nvr
RVR_DIR = ../rvr
BOOST_DIR = /usr/local
GLEW_DIR = /usr/local
GLE_DIR = /opt/GLE

INC = -I. -I../Gears/include -I../VLD -I$(BOOST_DIR)
CFLAGS = $(INC) -DMacOSX -DMACOSX $(G)
CXXFLAGS = $(CFLAGS) -DNDEBUG -DGL_SILENCE_DEPRECATION \
	`$(VFRDIR)/config/vfr-config --prefix=$(VFRDIR) --Wx --cflags` \
	`xml2-config --cflags` \
	-I$(TP_DIR)/include \
	-I$(NVR_DIR)/include -I$(RVR_DIR)/include -I$(GLEW_DIR)/include \
	-I$(GLE_DIR)/include
LDLIBS = `$(VFRDIR)/config/vfr-config --prefix=$(VFRDIR) --Wx --libs` \
	`env PKG_CONFIG_PATH="/usr/local/opt/libxml2/lib/pkgconfig" pkg-config --libs libxml-2.0` \
	-lTP -lNVR -lRVR -lglew -lz -liconv -lgle
LDFLAGS = `$(VFRDIR)/config/vfr-config --prefix=$(VFRDIR) --Wx --ldflags` \
	-L$(TP_DIR)/lib -L$(NVR_DIR)/lib -L$(RVR_DIR)/lib -L$(GLEW_DIR)/lib \
	-L$(GLE_DIR)/lib

INSTALL = /usr/bin/install -c

DEPEND = makedepend -Y
STRIP = strip
ifeq ($(G), -g)
  STRIP=@echo
endif


PROGRAM = Visio

include OBJS_LST.UNIX

ifeq ($(PGSQL), yes)
  CXXFLAGS += -DPGSQL
  INC += -I./PGSQL -I/usr/local/pgsql/include
  OBJS += \
	PGSQL/vsnData_SvSQL.o \
	PGSQL/vsnMethod_SvSQL_pgsql.o
  LDFLAGS += -L/usr/local/pgsql/lib
  LDLIBS += -lpq
endif


BUNDLE = $(PROGRAM).app/Contents
COPYRIGHT = 2005-2010 RIKEN
VERSION = `grep vsn_version vsnApp.h | awk '{print $$NF}' | sed -e 's/;//' -e 's/"//g'`

all : bundle

#
# Targets to build a Mac OS X application bundle
#
bundle: $(BUNDLE)/MacOS/$(PROGRAM) \
	$(BUNDLE)/Info.plist \
	$(BUNDLE)/PkgInfo \
	$(BUNDLE)/doc/Visio_UG.pdf \
	$(BUNDLE)/doc/DFF_V-Tools.pdf \
	$(BUNDLE)/Resources/$(PROGRAM).rsrc \
	$(BUNDLE)/Resources/$(PROGRAM).icns

$(BUNDLE)/Info.plist: $(TMPLDIR)/Info.plist.in 
	@$(INSTALL) -d `dirname $@`
	sed -e "s/IDENTIFIER/`echo $(program_dir) | sed 's,/,.,g'`/" \
	    -e "s/EXECUTABLE/$(PROGRAM)/" \
	    -e "s/ICONFILE/$(PROGRAM)\.icns/" \
	    -e "s/COPYRIGHT/$(COPYRIGHT)/" \
	    -e "s/????/vsns/" \
	    -e "s/VERSION/$(VERSION)/" $< > $@

$(BUNDLE)/PkgInfo:
	@$(INSTALL) -d `dirname $@`
	echo -n "APPLvsns" > $@

$(BUNDLE)/doc/Visio_UG.pdf:
	@$(INSTALL) -d `dirname $@`
	cp ../doc/Visio_UG.pdf $@

$(BUNDLE)/doc/DFF_V-Tools.pdf:
	@$(INSTALL) -d `dirname $@`
	cp ../doc/DFF_V-Tools.pdf $@

$(BUNDLE)/MacOS/$(PROGRAM): $(PROGRAM)
	@$(INSTALL) -d `dirname $@`
	cp $< $@
	./inst_local_dylib.sh $@
	./inst_local_dylib.sh $@ /opt/GLE

$(BUNDLE)/Resources/$(PROGRAM).rsrc: $(TMPLDIR)/tmpl.rsrc
	@$(INSTALL) -d `dirname $@`
	cp $< $@

$(BUNDLE)/Resources/$(PROGRAM).icns: $(TMPLDIR)/tmpl.icns
	@$(INSTALL) -d `dirname $@`
	cp $< $@


$(PROGRAM) : $(OBJS) 
	$(CXX) $(G) $(LDFLAGS) -o $@ $(OBJS) $(LDLIBS)
	$(STRIP) $(PROGRAM)

clean :
	$(RM) $(OBJS)

distclean :
	$(RM) -r $(PROGRAM).app
	$(RM) $(PROGRAM)


depend:
	$(DEPEND) -I. *.cpp

