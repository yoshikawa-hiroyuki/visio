<?xml version="1.0" encoding="UTF-8"?>
<vsn_tmpl name="GRAPH_PLOT" type="Sv:Otv">
  <method type="sampler" />
  <method type="graphPlot" />
  <command target="$1" name="set_divM" value="16" />
  <command target="$1" name="set_divN" value="1" />
  <command target="$2" name="set_sampler" value="$1" />
  <command target="$2" name="set_use_data" value="data0" />
  <command target="$1" name="set_line_width" value="0.0" />
  <command target="$1" name="set_point_size" value="2.5" />
  <command target="App" name="add_param_canvas" value="$0" />
  <command target="param_canvas;$0" name="add_method" value="$S/$D/$1" />
  <command target="param_canvas;$0" name="add_method" value="$S/$D/$2" />
  <command target="param_canvas;$0" name="set_geometry" value="-1,-1,600,-1" />
</vsn_tmpl>
